programa {
  funcao inicio() {
    cadeia verificou
    cadeia cafeteira
    cadeia agua
    cadeia cafe
    cadeia apreciar
    cadeia ligada
    cadeia encheu
    cadeia botasse
    cadeia preparasse
    cadeia servir

    
    escreva("verificou se a cafeteira está limpa e funcionando? ")
    leia(verificou)
    escreva("se a cafeteira estiver ligada desligue essa bixiga agora! ")
    leia(ligada)
    escreva("encheu d'água a cuia da cafeteira? ")
    leia(encheu)
    escreva("boasse café nessa cafeteira caba? em ")
    leia(botasse)
    escreva("preparasse café pra matar esse leão de hoje? ")
    leia(preparasse)
    escreva("simbora servir esse café umbora? ")
    leia(servir)
    escreva("Vou tomar bem devagar o café pra apreciar o gosto! ")
    leia(apreciar)

  escreva(" verificou se a cafeteira está limpa e funcionando? ", verificou, " se a cafeteira estiver ligada desligue essa bixiga agora! ", ligada, " encheu d'água a cuia da cafeteira? ", encheu, " boasse café nessa cafeteira caba? em ", botasse, " preparasse café pra matar esse leão de hoje? ", preparasse, " simbora servir esse café umbora? ", servir, " Vou tomar bem devagar o café pra apreciar o gosto!", apreciar)
  }

}
